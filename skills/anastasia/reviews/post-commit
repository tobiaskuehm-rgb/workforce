#!/bin/sh
# Meldet nach jedem Commit, fuer wen ein Review faellig geworden ist.
# Blockiert nie: ein Fehler hier darf keinen Commit verhindern.
#
# Einhaengen:  ln -sf ../../skills/anastasia/reviews/post-commit .git/hooks/post-commit
# Aushaengen:  rm .git/hooks/post-commit
wurzel=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
python3 "$wurzel/skills/anastasia/reviews/review_faellig.py" --kurz 2>/dev/null
exit 0
