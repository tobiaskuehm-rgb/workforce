# Copy this file locally if you want to keep the two values outside the
# shell history. Both are only needed for the two steps that use them;
# they are not read by prepare or cleanup.

# The external HTTPS reverse-proxy URL that already answers /health,
# /db-check and /bus/v1/status (the one validated on 2026-08-21).
BUS_REALTEST_BASE_URL=https://REPLACE-WITH-YOUR-REVERSE-PROXY-HOSTNAME:8443

# A short reference for why this test ran, e.g. a DEC-... decision number.
# Written into bus_channels.source_ref and bus_credentials.source_ref so the
# audit trail shows which decision authorized the test.
BUS_REALTEST_SOURCE_REF=DEC-PENDING/ENG-003
