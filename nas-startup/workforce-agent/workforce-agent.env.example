# Copy to workforce-agent.env on the NAS and fill in. Never commit the real file.

# --- Fail-closed switches. Both must be flipped to start. ---
AGENT_ENABLED=false
AGENT_KILL_SWITCH=true

# --- Which identity's inbox the agent works ---
# The bus credential decides this; the token is issued by the prepare step.
AGENT_BUS_BASE_URL=https://192-168-68-78.k30068872219.direct.quickconnect.to:8443
AGENT_BUS_TOKEN_FILE=/run/secrets/agent_bus_token

# --- Data boundary: what may leave the NAS. See data_boundary.py. ---
#   METADATA_ONLY  subject, action class, ids - never the body (default)
#   BODY           subject plus the message body
#   FULL           BODY plus task and handoff references
AGENT_DATA_POLICY=METADATA_ONLY

# --- Model provider ---
#   echo    deterministic, no network, no key - for the first dry run
#   claude  Anthropic API
AGENT_PROVIDER=echo
AGENT_MODEL=claude-opus-5
# Key from a file, not an env var: a file cannot be read out of `docker inspect`.
ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key

# --- Loop ---
AGENT_POLL_SECONDS=20
# Leave empty for continuous operation. Set to a small number for a bounded
# test run - the container then exits by itself instead of polling forever.
AGENT_MAX_CYCLES=3

# --- Hard ceilings for one run (security review F8) ---
# Any one of these ends the run. AGENT_MAX_CYCLES bounds passes over the inbox,
# not work done or money spent - these do. A message not reached stays
# DELIVERED and is picked up by a later run; nothing is swallowed.
AGENT_MAX_MESSAGES=25
AGENT_MAX_PROVIDER_CALLS=25
AGENT_MAX_TOKENS=200000
# Estimated spend in USD, computed from list prices - a safety stop, not
# billing. Keep the token and call ceilings as the reliable limits.
AGENT_MAX_COST_USD=1.00
