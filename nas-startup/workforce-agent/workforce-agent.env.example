# Copy to workforce-agent.env on the NAS and fill in. Never commit the real file.

# --- Fail-closed switches. Both must be flipped to start. ---
AGENT_ENABLED=false
AGENT_KILL_SWITCH=true

# --- Which identity's inbox the agent works ---
# The bus credential decides this; the token is issued by the prepare step.
AGENT_BUS_BASE_URL=https://192-168-68-78.k30068872219.direct.quickconnect.to:8443
AGENT_BUS_TOKEN_FILE=/run/secrets/agent_bus_token

# --- Data boundary: what may leave the NAS. See data_boundary.py. ---
# Two settings, and the stricter one always wins.
#
# The ceiling for the whole run:
#   METADATA_ONLY  subject, action class, ids - never the body
#   BODY           subject plus the message body
#   FULL           BODY plus task and handoff references
AGENT_DATA_POLICY=FULL
#
# A ceiling per sender, for identities whose content is more sensitive than
# the run-wide setting. Sensitivity belongs to whoever wrote the message, not
# to the run that happens to process it - so a finance or legal identity keeps
# its restriction no matter how permissive a run is configured. These can only
# narrow, never widen.
#
#   AGENT_DATA_POLICY_OVERRIDES=FIN-001:METADATA_ONLY,LEGAL-001:BODY
AGENT_DATA_POLICY_OVERRIDES=

# --- Model provider ---
#   echo          deterministic, no network, no key - for the first dry run
#   claude        Anthropic API, billed per token
#   subscription  a CLI signed in with a Claude or ChatGPT plan
AGENT_PROVIDER=echo

# --- Subscription provider ---
# Codex CLI and Claude Code can sign in with the matching consumer plan, so an
# exhausted quota is a wait rather than an invoice. The catch is the opposite
# of the API's: those CLIs exist to *act* - files, shell, network - and the
# agent's whole safety argument rests on the model having none of that.
#
# Therefore: run this provider in a container with no mounts, no route to the
# bus and nothing worth reaching. A flag that disables tools is welcome but is
# not the control; the control is that there is nothing to act on.
#
# argv as a JSON list. Look up the flags for your installed CLI version rather
# than trusting an example - they differ between CLIs and between versions.
# Use {prompt} as a placeholder if your CLI wants the prompt as an argument;
# otherwise it arrives on stdin.
# AGENT_SUBSCRIPTION_COMMAND=["claude", "-p"]
AGENT_SUBSCRIPTION_TIMEOUT=180
#
# Note: the quota consumed here is the same one you use interactively. An
# agent working overnight can leave you without your own limit in the morning.
AGENT_MODEL=claude-opus-5
# Key from a file, not an env var: a file cannot be read out of `docker inspect`.
ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# On the NAS this must stay true: it removes the environment fallback
# entirely and refuses to start rather than accept a key that way
# (review finding G-010). Leave it unset for local experiments.
AGENT_STRICT_SECRETS=true

# --- Loop ---
AGENT_POLL_SECONDS=20
# Leave empty for continuous operation. Set to a small number for a bounded
# test run - the container then exits by itself instead of polling forever.
AGENT_MAX_CYCLES=3

# --- Hard ceilings for one run (security review F8) ---
# Any one of these ends the run. AGENT_MAX_CYCLES bounds passes over the inbox,
# not work done or money spent - these do. A message not reached stays
# DELIVERED and is picked up by a later run; nothing is swallowed.
AGENT_MAX_MESSAGES=25
AGENT_MAX_PROVIDER_CALLS=25
AGENT_MAX_TOKENS=200000
# Estimated spend in USD, computed from list prices - a safety stop, not
# billing. Keep the token and call ceilings as the reliable limits.
AGENT_MAX_COST_USD=1.00
# Wall-clock ceiling. The others bound work, not time - and an ACCEPTANCE
# credential is only valid for 30 minutes, so a run has to end well inside
# that (security review A3).
AGENT_MAX_RUNTIME_SECONDS=900

# --- Crash recovery (review finding G-001) ---
# The worker replies first and acknowledges afterwards, so a crash leaves the
# message DELIVERED and a later run sees it again. This file records how far
# each message got, so the retry resumes instead of paying for the model twice.
# Needs a durable volume.
AGENT_STATE_PATH=/var/lib/startup-agent/state.sqlite3
# After this many failed attempts a message gets one final "not processed"
# reply instead of circling forever.
AGENT_MAX_ATTEMPTS=3
