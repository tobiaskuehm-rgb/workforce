# Chain test: Telegram -> Connector -> Bus -> Agent -> Bus -> Connector -> Telegram
# Copy to chain.env on the NAS and fill in the two ids from the identity probe.
# chain.env is gitignored (*.env); this example is not.

TELEGRAM_CONNECTOR_ENABLED=true
TELEGRAM_KILL_SWITCH=false
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
WORKFORCE_BUS_TOKEN_FILE=/run/secrets/workforce_bus_token
WORKFORCE_API_BASE_URL=https://192-168-68-78.k30068872219.direct.quickconnect.to:8443

# From identity_probe.py against the new test bot. Nothing else may talk to it.
TELEGRAM_ALLOWED_CHAT_ID=SET_AFTER_IDENTITY_PROBE
TELEGRAM_ALLOWED_USER_ID=SET_AFTER_IDENTITY_PROBE

# The agent, not a person. AI-ENG-001 would undo security review A1.
TELEGRAM_ALLOWED_RECIPIENT_IDS=AGENT-ENG-001

# Must match the task id used in the /task command, and it governs both
# directions: inbound the command is refused without it, outbound the answer
# text is withheld without it (review finding G-003).
TELEGRAM_ALLOWED_TASK_IDS=ENG-CHAIN-20260901

TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_STATE_PATH=/var/lib/startup-telegram/state.sqlite3

# The connector validates this as ^DEC-\d{3}/ENG-\d{3}$ and therefore cannot
# carry the honest CEO-CHAT-.../PENDING-DEC placeholder. DEC-023/ENG-007 is the
# decision that authorises this connector to exist, so it is the true value
# here - the chain test's own provenance is separate and sits in the SQL.
TELEGRAM_SOURCE_REF=DEC-023/ENG-007

# --- The decision you have to make before the run ---
# METADATA_ONLY  You see "an answer arrived", not what it says. Fail-closed
#                default. The chain is still proven: a notification in the chat
#                means the return leg worked.
# BODY           The answer text itself reaches the chat, shortened. Only for
#                messages whose task is on the allowlist above.
# Telegram bot chats are cloud chats without end-to-end encryption. BODY means
# internal work content is stored at Telegram.
TELEGRAM_OUTBOUND_POLICY=METADATA_ONLY
TELEGRAM_OUTBOUND_BODY_CHARS=500
