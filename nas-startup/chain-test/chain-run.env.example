# One fresh parameter source for one complete chain window.
# Copy to chain-run.env. That file is gitignored and must be kept until the
# cleanup and audit have both completed.

# Uppercase letters, digits and hyphens only; 6-48 characters. Never reuse a
# suffix: the corresponding connector identity is permanently retired.
CHAIN_RUN_SUFFIX=SET-FRESH-SUFFIX

# Must be exactly ENG-CHAIN- plus the suffix above. The validation script
# checks the relationship before anything is changed.
CHAIN_TASK_ID=ENG-CHAIN-SET-FRESH-SUFFIX
