# The agent side of the chain run. Copy to agent.chain.env on the NAS.

# Free, no network to any model provider, no key. DEC-027 and ENG-008 forbid a
# paid external service, so this is the requirement and not a shortcut.
AGENT_PROVIDER=echo

# Two switches, both fail-closed by default. The worker refuses to start
# unless BOTH are set: enabled on, kill switch off. Forgetting either one
# ends the run with AGENT_DISABLED_OR_KILL_SWITCH_ON and nothing happens.
AGENT_ENABLED=true
AGENT_KILL_SWITCH=false

# The identity comes from the credential, not from a variable - the token file
# below is what makes this run AGENT-ENG-001.
AGENT_BUS_BASE_URL=https://192-168-68-81.k30068872219.direct.quickconnect.to:8443
AGENT_BUS_TOKEN_FILE=/run/secrets/agent_bus_token
AGENT_STATE_PATH=/var/lib/startup-agent/state.sqlite3

# Not negotiable on the NAS: a key may only ever come from a file.
AGENT_STRICT_SECRETS=true

# Nothing of the message body leaves the NAS. With the echo provider nothing
# would reach a provider anyway - keeping the default means the run does not
# quietly widen the boundary it is meant to demonstrate.
AGENT_DATA_POLICY=METADATA_ONLY

# One pass is enough for the chain proof; the ceilings stay narrow so a
# misconfiguration cannot turn into a loop.
AGENT_MAX_CYCLES=3
AGENT_POLL_SECONDS=10
AGENT_MAX_MESSAGES=5
AGENT_MAX_PROVIDER_CALLS=5
AGENT_MAX_COST_USD=0
AGENT_MAX_RUNTIME_SECONDS=300
