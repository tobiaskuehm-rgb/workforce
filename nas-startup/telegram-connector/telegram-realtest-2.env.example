TELEGRAM_CONNECTOR_ENABLED=false
TELEGRAM_KILL_SWITCH=true
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_ALLOWED_CHAT_ID=SET_AFTER_IDENTITY_PROBE
TELEGRAM_ALLOWED_USER_ID=SET_AFTER_IDENTITY_PROBE
TELEGRAM_ALLOWED_RECIPIENT_IDS=AI-ENG-001
TELEGRAM_ALLOWED_TASK_IDS=ENG-TG-REALTEST-002
TELEGRAM_SOURCE_REF=DEC-026/ENG-007
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_STATE_PATH=/var/lib/startup-telegram/state.sqlite3
WORKFORCE_API_BASE_URL=https://192-168-68-81.k30068872219.direct.quickconnect.to:8443
WORKFORCE_BUS_TOKEN_FILE=/run/secrets/workforce_bus_token

# --- Zweite Datengrenze: was von der NAS nach Telegram geht ---
# METADATA_ONLY  IDs, Absender, Task, Status, Betreff - nie der Nachrichtentext.
#                Voreinstellung und bisheriges Verhalten.
# BODY           zusaetzlich ein gekuerzter Nachrichtentext, damit eine Antwort
#                in Telegram lesbar ist statt nur angekuendigt.
# Telegram-Bot-Chats sind Cloud-Chats ohne Ende-zu-Ende-Verschluesselung. BODY
# bedeutet, dass Inhalte interner Arbeitsnachrichten bei Telegram liegen.
TELEGRAM_OUTBOUND_POLICY=METADATA_ONLY
TELEGRAM_OUTBOUND_BODY_CHARS=500
