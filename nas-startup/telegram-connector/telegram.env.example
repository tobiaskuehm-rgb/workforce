# Copy to telegram.env only on the NAS and enter values there.
# Never upload telegram.env to chat, project sources or Git.
TELEGRAM_CONNECTOR_ENABLED=false
TELEGRAM_KILL_SWITCH=true
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_ALLOWED_CHAT_ID=SET_NUMERIC_PRIVATE_CHAT_ID
TELEGRAM_ALLOWED_USER_ID=SET_NUMERIC_CEO_USER_ID
TELEGRAM_ALLOWED_RECIPIENT_IDS=AI-ENG-001
TELEGRAM_ALLOWED_TASK_IDS=ENG-TG-REALTEST-001
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_STATE_PATH=/var/lib/startup-telegram/state.sqlite3
WORKFORCE_API_BASE_URL=https://192-168-68-78.k30068872219.direct.quickconnect.to:8443
WORKFORCE_BUS_TOKEN_FILE=/run/secrets/workforce_bus_token
